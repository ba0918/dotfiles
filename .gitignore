ai/codex/history.jsonl
ai/codex/session_index.jsonl
ai/codex/sessions/
ai/codex/log/
ai/codex/logs_*.sqlite*
ai/codex/state_*.sqlite*
ai/codex/models_cache.json
ai/codex/cache/
ai/codex/tmp/
ai/codex/.tmp/
ai/codex/installation_id
ai/codex/.personality_migration

