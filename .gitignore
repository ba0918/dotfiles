.idea
*.iml
.vscode
*.swp
*~
.DS_Store

# ===== Secrets / Credentials (ABSOLUTE NO COMMIT) =====
*.credentials.json
.credentials.json
auth.json
.auth.json
*auth_token*
*.pem
*.key
.env
.env.*
!.env.example
.git-credentials
*_rsa
*_ed25519
*_ecdsa
.serverlessrc

# ===== Claude Code conf.d generated files =====
ai/claude/conf.d/20-deny.json

# ===== Claude Code: allow-list (everything else is runtime / secret) =====
# Default-deny under ai/claude/. Tracked assets must be allow-listed below.
# When adding a new asset, add a matching "!" line here.
ai/claude/*
!ai/claude/.gitkeep
!ai/claude/CLAUDE.md
!ai/claude/bash-env.sh
!ai/claude/hooks/
!ai/claude/conf.d/
!ai/claude/build-settings
# (explicit allow-list is appended as assets are adopted)

# ===== Python dev artifacts =====
__pycache__/
*.pyc
.pytest_cache/

# Top-level runtime files (next to ~/.claude/) should never be committed.
ai/claude/.claude.json
ai/claude/.claude.json.backup

