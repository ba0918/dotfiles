logs
*.log
npm-debug.log*

# ===== Editor / IDE =====
.idea
*.iml
.vscode
*.swp
*~
.DS_Store

# ===== Secrets / Credentials (ABSOLUTE NO COMMIT) =====
*.credentials.json
.credentials.json
auth.json
.auth.json
*auth_token*
*.pem
*.key
.env
.env.*
!.env.example
.git-credentials
*_rsa
*_ed25519
*_ecdsa

# ===== Claude Code: allow-list (everything else is runtime / secret) =====
# Default-deny under claude/.claude/. Tracked assets must be allow-listed below.
# When adding a new asset, add a matching "!" line here.
claude/.claude/*
!claude/.claude/.gitkeep
!claude/.claude/CLAUDE.md
!claude/.claude/bash-env.sh
!claude/.claude/output-styles/
!claude/.claude/hooks/
# (explicit allow-list is appended as assets are adopted)

# ===== Python dev artifacts =====
__pycache__/
*.pyc
.pytest_cache/

# Top-level runtime files (outside .claude/ dir) should never be committed.
claude/.claude.json
claude/.claude.json.backup

# ===== Codex runtime artifacts =====
codex/.codex/history.jsonl
codex/.codex/session_index.jsonl
codex/.codex/sessions/
codex/.codex/log/
codex/.codex/logs_*.sqlite*
codex/.codex/state_*.sqlite*
codex/.codex/models_cache.json
codex/.codex/cache/
codex/.codex/tmp/
codex/.codex/.tmp/
codex/.codex/installation_id
codex/.codex/.personality_migration

