#!/usr/bin/env bash
# Global pre-commit hook: reject environment-specific terms in staged changes,
# then run secretlint on staged files.
#
# Installed into new repositories via `git init` / `git clone` template dir
# (see [init] templateDir in ~/.gitconfig). Existing repositories are not
# touched — symlink or copy this file into .git/hooks/pre-commit manually.
#
# Behavior (fail-secure): if any prerequisite is missing, the commit is
# rejected. Silent fallbacks are intentionally avoided because a hook that
# pretends to scan while doing nothing is worse than no hook at all.
#
#   - scans only the files currently staged for this commit
#   - rejects staged paths and added lines that contain a term from
#     ${XDG_STATE_HOME:-~/.local/state}/leak-terms.txt (one fixed string per
#     line, case-insensitive; user name, host name, ...). The list is kept
#     outside dotfiles so the terms themselves are never committed; a missing
#     or empty list rejects the commit
#   - runs the secretlint installed next to the global config
#     (~/.config/secretlint/node_modules, from the dotfiles lockfile), never
#     whatever `secretlint` happens to be on PATH
#   - rejects the commit if that install is missing
#   - honors a project-local .secretlintrc* if present; otherwise uses the
#     global config shipped with dotfiles. A project that ships its own
#     secretlint (node_modules/.bin/secretlint) is scanned with that one

set -euo pipefail

# Gather staged added / modified file paths (skip deletions). With rename
# detection (git's default) a moved file is neither A nor M and would skip
# every check, so renames are listed as the path they are added under. The
# paths are passed on as file arguments, so non-ASCII ones must not be quoted.
mapfile -t STAGED < <(git -c core.quotePath=false diff --cached --name-only --no-renames --diff-filter=AM)
if [[ ${#STAGED[@]} -eq 0 ]]; then
    exit 0
fi

LEAK_TERMS_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/leak-terms.txt"

# The list is edited by hand: blanks around a term would keep it from ever
# matching, and a blank line is not a term.
mapfile -t LEAK_TERMS < <(sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e '/^$/d' "$LEAK_TERMS_FILE" 2>/dev/null)
if [[ ${#LEAK_TERMS[@]} -eq 0 ]]; then
    echo "[pre-commit] no terms in $LEAK_TERMS_FILE (missing or empty) — rejecting commit for safety." >&2
    echo "[pre-commit] create it with one term per line (user name, host name, ...)." >&2
    echo "[pre-commit] override (risky):    git commit --no-verify" >&2
    exit 1
fi

# Print each staged path and each added line that contains a term, compared
# case-insensitively as fixed strings.
find_leaks() {
    git -c core.quotePath=false diff --cached -U0 --no-renames --diff-filter=AM \
        --no-color --no-ext-diff --no-textconv --no-prefix |
        LEAK_TERMS_LIST="$(printf '%s\n' "${LEAK_TERMS[@]}")" \
        STAGED_LIST="$(printf '%s\n' "${STAGED[@]}")" \
        awk '
            function has_term(text,    i) {
                text = tolower(text)
                for (i = 1; i <= term_count; i++)
                    if (index(text, terms[i])) return 1
                return 0
            }
            BEGIN {
                term_count = split(tolower(ENVIRON["LEAK_TERMS_LIST"]), terms, "\n")
                path_count = split(ENVIRON["STAGED_LIST"], paths, "\n")
                for (i = 1; i <= path_count; i++)
                    if (has_term(paths[i])) print "  path: " paths[i]
            }
            # "+++ " is a file header only before the first hunk; inside a
            # hunk it is an added line whose text starts with "++".
            /^diff --git / { in_hunk = 0; next }
            !in_hunk && /^\+\+\+ / { file = substr($0, 5); next }
            /^@@/ { in_hunk = 1; next }
            in_hunk && /^\+/ && has_term(substr($0, 2)) { print "  " file ":" $0 }
        '
}

LEAKS="$(find_leaks)"
if [[ -n "$LEAKS" ]]; then
    echo "[pre-commit] staged changes contain a term listed in $LEAK_TERMS_FILE:" >&2
    printf '%s\n' "$LEAKS" >&2
    echo "[pre-commit] remove the term, or (only if you are sure) bypass with: git commit --no-verify" >&2
    exit 1
fi

# The install lives next to the global config, so the binary and the preset
# the config names resolve from the same node_modules. Resolving `secretlint`
# through PATH instead is exactly how this hook broke once: a differently
# installed copy without the preset was found first and rejected every commit.
GLOBAL_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/secretlint"
GLOBAL_CONFIG="$GLOBAL_DIR/.secretlintrc.json"
GLOBAL_BIN="$GLOBAL_DIR/node_modules/.bin/secretlint"

# The binary is a node script. A GUI client or editor integration may invoke
# the hook without the shell that activates mise, so fall back to its shims.
if ! command -v node >/dev/null 2>&1; then
    MISE_SHIMS="${MISE_DATA_DIR:-$HOME/.local/share/mise}/shims"
    if [[ -d "$MISE_SHIMS" ]]; then
        PATH="$MISE_SHIMS:$PATH"
    fi
fi

# Let project-level config win; otherwise use the global dotfiles config.
PROJECT_CONFIG=""
for candidate in .secretlintrc.json .secretlintrc.yaml .secretlintrc.yml .secretlintrc.js .secretlintrc; do
    if [[ -f "$candidate" ]]; then
        PROJECT_CONFIG="$candidate"
        break
    fi
done

if [[ -n "$PROJECT_CONFIG" && -x node_modules/.bin/secretlint ]]; then
    CMD=(node_modules/.bin/secretlint "${STAGED[@]}")
else
    if [[ ! -x "$GLOBAL_BIN" ]]; then
        echo "[pre-commit] secretlint is not installed at $GLOBAL_BIN — rejecting commit for safety." >&2
        echo "[pre-commit] install:             mise run bootstrap   (npm ci in $GLOBAL_DIR)" >&2
        echo "[pre-commit] override (risky):    git commit --no-verify" >&2
        exit 1
    fi
    if [[ -n "$PROJECT_CONFIG" ]]; then
        CMD=("$GLOBAL_BIN" "${STAGED[@]}")
    else
        if [[ ! -f "$GLOBAL_CONFIG" ]]; then
            echo "[pre-commit] no project .secretlintrc and global config missing: $GLOBAL_CONFIG" >&2
            echo "[pre-commit] rejecting commit — apply dotfiles (mise bootstrap) to provision it." >&2
            exit 1
        fi
        CMD=("$GLOBAL_BIN" --secretlintrc "$GLOBAL_CONFIG" "${STAGED[@]}")
    fi
fi

if ! "${CMD[@]}"; then
    echo "" >&2
    echo "[pre-commit] secretlint detected potential secrets in staged files." >&2
    echo "[pre-commit] fix the findings, or (only if you are sure) bypass with: git commit --no-verify" >&2
    exit 1
fi
