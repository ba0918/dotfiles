{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "{{ vars.dotfiles_root }}/ai/shared/interaction.md",
    "{{ vars.dotfiles_root }}/ai/shared/human-readable.md",
    "{{ vars.dotfiles_root }}/ai/shared/persona/gal.md"
  ],
  "permission": {
    "*": "ask",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "**/.ssh/**": "deny",
      "**/.aws/**": "deny",
      "**/.aws-sam/**": "deny",
      "**/.config/gcloud/**": "deny",
      "**/.npmrc": "deny",
      "**/.pypirc": "deny",
      "*.vars": "deny",
      "*.pem": "deny"
    },
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "todowrite": "allow",
    "skill": "allow",
    "question": "allow",
    "websearch": "allow",
    "external_directory": {
      "**/.ssh/**": "deny",
      "**/.aws/**": "deny",
      "**/.aws-sam/**": "deny",
      "**/.config/gcloud/**": "deny",
      "**/.npmrc": "deny",
      "**/.pypirc": "deny",
      "**/.env": "deny",
      "*.pem": "deny",
      "*": "ask"
    },
    "bash": {
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git grep*": "allow",
      "git add*": "allow",
      "git fetch*": "allow",
      "git pull*": "allow",
      "git checkout*": "allow",
      "git branch*": "allow",
      "git commit*": "allow",
      "git push*": "ask",
      "rg *": "allow",
      "grep *": "allow",
      "cargo check*": "allow",
      "cargo test*": "allow",
      "cargo fmt*": "allow",
      "cargo clippy*": "allow",
      "npm test*": "allow",
      "npm run *": "allow",
      "pnpm test*": "allow",
      "pnpm run *": "allow",
      "ls *": "allow",
      "cd *": "allow",
      "mkdir *": "allow",
      "echo *": "allow",
      "diff *": "allow",
      "curl *": "ask",
      "wget *": "ask",
      "rm *": "ask",
      "sudo *": "deny",
      "ssh *": "deny",
      "scp *": "deny",
      "*": "ask"
    },
    "webfetch": "ask",
    "doom_loop": "ask"
  },
  "plugin": [
    "claude-skills@git+https://github.com/ba0918/claude-skills.git"
  ]
}
