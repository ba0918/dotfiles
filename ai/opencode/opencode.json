      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*.jks": "deny",
      "*.keystore": "deny",
      "**/.serverlessrc": "deny",
      "**/.git-credentials": "deny",
      "**/.netrc": "deny",
      "**/.pgpass": "deny",
      "**/.my.cnf": "deny",
      "**/auth.json": "deny",
      "**/.auth.json": "deny",
      "**/*auth_token*": "deny",
