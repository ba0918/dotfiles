      "**/id_ecdsa": "deny",
      "**/id_ecdsa.*": "deny",
      "**/known_hosts": "deny",
      "*": "ask"
    },
    "bash": {
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git grep*": "allow",
      "git add*": "allow",
      "git fetch*": "allow",
      "git pull*": "allow",
      "git checkout*": "allow",
      "git branch*": "allow",
      "git commit*": "allow",
      "git push*": "ask",
      "rg *": "allow",
      "grep *": "allow",
      "cargo check*": "allow",
      "cargo test*": "allow",
      "cargo fmt*": "allow",
      "cargo clippy*": "allow",
      "npm test*": "allow",
      "npm run *": "allow",
      "pnpm test*": "allow",
      "pnpm run *": "allow",
      "ls *": "allow",
      "cd *": "allow",
      "mkdir *": "allow",
      "echo *": "allow",
      "diff *": "allow",
      "curl *": "ask",
      "wget *": "ask",
      "rm *": "ask",
      "sudo *": "deny",
      "ssh *": "deny",
      "scp *": "deny",
      "*": "ask"
    },
    "webfetch": "ask",
    "doom_loop": "ask"
  },
  "plugin": [
    "ba0918/claude-skills"
  ]
}
