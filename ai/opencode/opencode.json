      "*.p12": "deny",
      "*.pfx": "deny",
      "*.jks": "deny",
      "*.keystore": "deny",
      "**/.serverlessrc": "deny",
      "**/.git-credentials": "deny",
      "**/.netrc": "deny",
      "**/.pgpass": "deny",
      "**/.my.cnf": "deny",
      "**/auth.json": "deny",
      "**/.auth.json": "deny",
      "**/*auth_token*": "deny",
      "**/credentials": "deny",
      "**/credentials.json": "deny",
      "**/credentials.toml": "deny",
      "**/credentials.yaml": "deny",
      "**/credentials.yml": "deny",
      "**/secrets.json": "deny",
      "**/secrets.toml": "deny",
      "**/secrets.yaml": "deny",
