    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "todowrite": "allow",
    "skill": "allow",
    "question": "allow",
    "websearch": "allow",
    "external_directory": {
      "**/.ssh/**": "deny",
      "**/.aws/**": "deny",
