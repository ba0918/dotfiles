{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "run-if-present path ~/.codex/herdr-agent-state.sh -- bash ~/.codex/herdr-agent-state.sh session",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.codex/hooks/block_dangerous_command.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.codex/hooks/detect_secret.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 ~/.codex/hooks/detect_mojibake.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
