#!/usr/bin/env bash
#
# Build ~/.claude/settings.json from conf.d/ fragments.
#
# Merges conf.d/*.json in numeric order, then preserves runtime-added
# permissions.allow and permissions.ask from the existing settings.json
# (unless --clean is passed).
#
# Usage:
#   build-settings              # build with runtime allow preservation
#   build-settings --clean      # reset runtime allow to baseline
#   build-settings --dry-run    # print result without writing
#   build-settings --status     # show managed vs runtime allow entries
#
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(dirname "$(dirname "$SCRIPT_DIR")")"
# MISE_GLOBAL_CONFIG_ROOT (set by bootstrap.sh / fish config.fish, verified by the mise
# pre-dotfiles hook) is the canonical checkout that $DOTFILES_ROOT expands to; when the
# variable is unset or empty, fall back to the repository this script lives in.
DOTFILES_ROOT="${MISE_GLOBAL_CONFIG_ROOT:-$REPO_ROOT}"
CONF_DIR="$SCRIPT_DIR/conf.d"
TARGET="$HOME/.claude/settings.json"
GENERATE_DENY="$REPO_ROOT/scripts/generate-deny.sh"

CLEAN=false
DRY_RUN=false
STATUS=false

for arg in "$@"; do
  case "$arg" in
    --clean)   CLEAN=true ;;
    --dry-run) DRY_RUN=true ;;
    --status)  STATUS=true ;;
    *)
      echo "usage: build-settings [--clean] [--dry-run] [--status]" >&2
      exit 1
      ;;
  esac
done

if ! command -v jq >/dev/null 2>&1; then
  echo "error: jq is required but not found" >&2
  exit 1
fi

# Keep generated deny rules in memory so inspection never writes to the checkout.
if [ -x "$GENERATE_DENY" ]; then
  DENY=$("$GENERATE_DENY" claude)
else
  echo "error: generate-deny.sh not found or not executable at $GENERATE_DENY" >&2
  exit 1
fi

# Step 2: Merge conf.d/*.json in numeric order (deep merge)
# NOTE: jq's * operator replaces arrays (not appends). Each array key
# (e.g. permissions.allow) must appear in exactly ONE conf.d file.
BASE=$(jq -n '{}')
while IFS= read -r f; do
  if [ "$f" = "$CONF_DIR/20-deny.json" ]; then
    BASE=$(echo "$BASE" | jq --argjson deny "$DENY" '. * $deny')
  else
    [ -f "$f" ] || continue
    BASE=$(echo "$BASE" | jq -s '.[0] * .[1]' - "$f")
  fi
done < <(printf '%s\n' "$CONF_DIR"/*.json "$CONF_DIR/20-deny.json" | sort -u)

# Keep the unexpanded env.PATH for the order check in Step 5. Step 3 expands the trailing
# $PATH token in the same pass as the other variables and leaves no unexpanded copy behind.
RAW_ENV_PATH=$(echo "$BASE" | jq -r '.env.PATH // ""')

# Step 3: Expand $HOME, $DOTFILES_ROOT and $PATH in merged base. The // prefixed forms
# (//$HOME/ and //$DOTFILES_ROOT/) are expanded first, with the leading slash of the
# expansion dropped, so a permission rule keeps its // prefix (//home/...) instead of
# turning into ///home/...
# env.PATH is the PATH that Claude Code's Bash tool and hooks run with, so it has to be
# a complete list: $PATH carries the inherited entries, and $DOTFILES_ROOT lets the
# kakoi shim directory be placed ahead of the mise shims directory.
HOME_NO_SLASH="${HOME#/}"
DOTFILES_ROOT_NO_SLASH="${DOTFILES_ROOT#/}"
BASE=$(echo "$BASE" | jq \
  --arg home_abs "$HOME" --arg home_rel "$HOME_NO_SLASH" --arg path "${PATH:-}" \
  --arg dotfiles_root "$DOTFILES_ROOT" --arg dotfiles_root_rel "$DOTFILES_ROOT_NO_SLASH" \
  'walk(if type == "string" then gsub("//\\$HOME/"; "//" + $home_rel + "/") | gsub("\\$HOME"; $home_abs) | gsub("//\\$DOTFILES_ROOT/"; "//" + $dotfiles_root_rel + "/") | gsub("\\$DOTFILES_ROOT"; $dotfiles_root) | gsub("\\$PATH"; $path) else . end)')

# Step 4: Handle --status
if $STATUS; then
  if [ -f "$TARGET" ]; then
    BASE_ALLOW=$(echo "$BASE" | jq -r '.permissions.allow // [] | .[]' | sort)
    CURRENT_ALLOW=$(jq -r '.permissions.allow // [] | .[]' "$TARGET" | sort)
    RUNTIME_ALLOW=$(comm -13 <(echo "$BASE_ALLOW") <(echo "$CURRENT_ALLOW"))

    echo "=== Managed allow entries (from conf.d/25-allow.json) ==="
    echo "$BASE_ALLOW" | wc -l | xargs printf "%d entries\n"
    echo ""
    echo "=== Runtime-added allow entries ==="
    if [ -n "$RUNTIME_ALLOW" ]; then
      echo "$RUNTIME_ALLOW"
      echo "$RUNTIME_ALLOW" | wc -l | xargs printf "\n%d runtime entries\n"
    else
      echo "(none)"
    fi
  else
    echo "no existing settings.json found at $TARGET"
  fi
  exit 0
fi

# Step 5: Check the order of env.PATH before anything is written (docs/spec/safe-chain-path.md,
# section 3.2). Only the entries written in conf.d are checked: the trailing $PATH token, which
# brings in the PATH of the shell that ran this script, is dropped before comparing. The
# inherited part differs by shell, and fish already carries the Safe Chain directories there,
# so checking the expanded value would not notice an entry missing from conf.d.
#
# This PATH is what Claude Code's Bash tool and hooks run with, so the first four entries are
# fixed, in this order:
#   1. the kakoi shim directory: the host runs codex from there, and it has to beat the
#      mise shims or codex runs outside the isolation;
#   2. the Safe Chain shims: after the mise shims, npm / pnpm / bun / pip resolve to mise and
#      skip Safe Chain;
#   3. the mise shims;
#   4. the Safe Chain binary: the shims only need `command -v safe-chain` to succeed, and only
#      fish puts that directory on PATH. It goes after the mise shims because nothing in it
#      needs to win, and anything that later appears there would otherwise shadow a
#      mise-pinned tool.
# A generated settings.json with these out of order would silently drop the protection, which
# is why the script fails here instead of writing (AGENTS.md rule 7).
CHECKED_PATH="${RAW_ENV_PATH%:\$PATH}"
CHECKED_PATH="${CHECKED_PATH//\$HOME/$HOME}"
CHECKED_PATH="${CHECKED_PATH//\$DOTFILES_ROOT/$DOTFILES_ROOT}"
IFS=: read -r -a PATH_ENTRIES <<< "$CHECKED_PATH"
EXPECTED_PATH_HEAD=(
  "$DOTFILES_ROOT/ai/kakoi/shim"
  "$HOME/.safe-chain/shims"
  "$HOME/.local/share/mise/shims"
  "$HOME/.safe-chain/bin"
)
for i in 0 1 2 3; do
  if [ "${PATH_ENTRIES[$i]:-}" != "${EXPECTED_PATH_HEAD[$i]}" ]; then
    echo "error: env.PATH in conf.d/40-env.json is out of order: entry $((i + 1)) must be" >&2
    echo "  ${EXPECTED_PATH_HEAD[$i]}" >&2
    echo "but is" >&2
    echo "  ${PATH_ENTRIES[$i]:-(missing)}" >&2
    echo "The first four entries must be, in order:" >&2
    printf '  %s\n' "${EXPECTED_PATH_HEAD[@]}" >&2
    echo "settings.json was not written. See docs/spec/safe-chain-path.md section 3.2." >&2
    exit 1
  fi
done

# Step 6: Merge runtime allow/ask from existing settings.json
if ! $CLEAN && [ -f "$TARGET" ]; then
  # Extract runtime-added allow entries (in existing but not in base)
  RUNTIME_ALLOW=$(jq -n \
    --argjson base "$(echo "$BASE" | jq '.permissions.allow // []')" \
    --argjson current "$(jq '.permissions.allow // []' "$TARGET")" \
    '$current - $base')

  # Extract runtime-added ask entries
  RUNTIME_ASK=$(jq -n \
    --argjson base "$(echo "$BASE" | jq '.permissions.ask // []')" \
    --argjson current "$(jq '.permissions.ask // []' "$TARGET")" \
    '$current - $base')

  # Append runtime entries to base
  RESULT=$(echo "$BASE" | jq \
    --argjson runtime_allow "$RUNTIME_ALLOW" \
    --argjson runtime_ask "$RUNTIME_ASK" \
    '.permissions.allow = (.permissions.allow + $runtime_allow | unique) |
     .permissions.ask = (.permissions.ask + $runtime_ask | unique)')
else
  RESULT="$BASE"
fi

# Step 7: Output
if $DRY_RUN; then
  echo "$RESULT" | jq .
else
  printf '%s\n' "$DENY" > "$CONF_DIR/20-deny.json"
  mkdir -p "$(dirname "$TARGET")"
  echo "$RESULT" | jq . > "$TARGET"
  echo "settings.json written to $TARGET"
fi
