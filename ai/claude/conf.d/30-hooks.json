{
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "run-if-present --chdir \"$HOME/develop/claude-notify\" path \"$HOME/develop/claude-notify\" -- python3 -m claude_notify"
          }
        ]
      },
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "run-if-present --chdir \"$HOME/develop/claude-notify\" path \"$HOME/develop/claude-notify\" -- python3 -m claude_notify"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/detect_mojibake.py"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/detect_secret.py"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "run-if-present path \"$HOME/.orca/agent-hooks/claude-hook.sh\" -- /bin/sh \"$HOME/.orca/agent-hooks/claude-hook.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/block_dangerous_command.py"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "run-if-present path \"$HOME/.orca/agent-hooks/claude-hook.sh\" -- /bin/sh \"$HOME/.orca/agent-hooks/claude-hook.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "run-if-present path \"$HOME/.claude/hooks/herdr-agent-state.sh\" -- bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "run-if-present path \"$HOME/.orca/agent-hooks/claude-hook.sh\" -- /bin/sh \"$HOME/.orca/agent-hooks/claude-hook.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "run-if-present --chdir \"$HOME/develop/claude-notify\" path \"$HOME/develop/claude-notify\" -- python3 -m claude_notify"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "run-if-present path \"$HOME/.orca/agent-hooks/claude-hook.sh\" -- /bin/sh \"$HOME/.orca/agent-hooks/claude-hook.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "run-if-present path \"$HOME/.orca/agent-hooks/claude-hook.sh\" -- /bin/sh \"$HOME/.orca/agent-hooks/claude-hook.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "run-if-present path \"$HOME/.orca/agent-hooks/claude-hook.sh\" -- /bin/sh \"$HOME/.orca/agent-hooks/claude-hook.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "run-if-present path \"$HOME/.orca/agent-hooks/claude-hook.sh\" -- /bin/sh \"$HOME/.orca/agent-hooks/claude-hook.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "run-if-present path \"$HOME/.orca/agent-hooks/claude-hook.sh\" -- /bin/sh \"$HOME/.orca/agent-hooks/claude-hook.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "run-if-present path \"$HOME/.orca/agent-hooks/claude-hook.sh\" -- /bin/sh \"$HOME/.orca/agent-hooks/claude-hook.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "run-if-present path \"$HOME/.orca/agent-hooks/claude-hook.sh\" -- /bin/sh \"$HOME/.orca/agent-hooks/claude-hook.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "run-if-present path \"$HOME/.orca/agent-hooks/claude-hook.sh\" -- /bin/sh \"$HOME/.orca/agent-hooks/claude-hook.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "run-if-present path \"$HOME/.orca/agent-hooks/claude-hook.sh\" -- /bin/sh \"$HOME/.orca/agent-hooks/claude-hook.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "run-if-present path \"$HOME/.orca/agent-hooks/claude-hook.sh\" -- /bin/sh \"$HOME/.orca/agent-hooks/claude-hook.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
